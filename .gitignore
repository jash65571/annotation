# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Run artifacts (generated evidence output, never committed)
artifacts/*
!artifacts/.gitkeep

# Test fixtures are generated locally with ffmpeg, never committed
tests/fixtures/*
!tests/fixtures/.gitkeep

# Private regression media is never committed; manifests are
tests/regression/media/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Raw Manuscript II project documents are local-only (distribution rights
# unclear); only references/README.md is committed.
references/*
!references/README.md
