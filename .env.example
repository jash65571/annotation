# AutoScribe configuration — copy this file to `.env` and fill in your values.
# `.env` is gitignored; never commit real keys.

# REQUIRED: your OpenAI API key (used for vision + audio transcription).
OPENAI_API_KEY=sk-proj-your-key-here

# REQUIRED unless ffmpeg/ffprobe are already on your PATH:
# directory that contains ffmpeg + ffprobe (Windows example shown).
AUTOSCRIBE_FFMPEG_DIR=C:\ffbin

# OPTIONAL — sensible defaults shown.
AUTOSCRIBE_MODE=structured        # structured (Manuscript format) | flat (simple timeline)
AUTOSCRIBE_VISION=openai          # openai | cloud (Anthropic) | ollama | manual
OPENAI_MODEL=gpt-4o               # any vision-capable model on your account
